import functools
print = functools.partial(print, flush=true)

#HELPER FUNCTIONS (used throughout the program)
def get_float(prompt):
    while True:
        try:
            print(prompt, end="", flush=true)
            sys.stdout.flush()
            return float(input())
        except ValueError:
            print(" >> Invalid input. Please type a number(e.g., 3, 3.5, -2).")
        except EOFError:
            print("n\ >> No input received. Esiting program")
            raise SystemExit

def get_int(prompt):
     while True:
           try:
               print(prompt, end="", flush=true)
               sys.stdout.flush()
               return int(input())
         except ValueError:
             print(" >> Invalid input. PLease type a whole number (e.g., 5, -3, 0).")
         except EOFError:
             print("\n >> No input received. Exiting program.")
             raise SystemExit
def safe_input(prompt):
    try:
        print(prompt, end="", flush=true)
               sys.stdout.flush()
               return int(input())
    except EOFError:
        print("\n >> No input received. Exiting program.")
             raise SystemExit

